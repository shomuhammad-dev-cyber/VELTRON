{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install --legacy-peer-deps",
  "cleanUrls": true,
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/v1/health",
      "schedule": "0 */12 * * *"
    }
  ]
}
