# ==============================================================================
# VALIXEN FINTECH PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.production (or configure in Vercel / Cloudflare Dashboard).
# STRICT SECURITY WARNING: NEVER COMMIT ACTUAL PRODUCTION SECRETS TO GIT REPOSITORIES.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION HOSTING & CANONICAL DOMAIN
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_URL="https://valixen.com"
NEXT_PUBLIC_APP_NAME="VALIXEN"

# ------------------------------------------------------------------------------
# 2. MANAGED POSTGRESQL DATABASE (Neon / Supabase / AWS RDS / Prisma Accelerate)
# ------------------------------------------------------------------------------
# Transaction pooler URL (e.g., PgBouncer / Neon pooled connection)
DATABASE_URL="postgresql://valixen_admin:CHANGE_ME_PASSWORD@ep-valixen-production.us-east-1.aws.neon.tech/valixen_prod?sslmode=require&pgbouncer=true"

# Direct URL for schema migrations (optional, bypasses transaction pooler)
DIRECT_URL="postgresql://valixen_admin:CHANGE_ME_PASSWORD@ep-valixen-production.us-east-1.aws.neon.tech/valixen_prod?sslmode=require"

# ------------------------------------------------------------------------------
# 3. HIGH-SPEED DISTRIBUTED CACHE & RATE LIMITING (Redis / Upstash)
# ------------------------------------------------------------------------------
REDIS_URL="rediss://default:CHANGE_ME_REDIS_TOKEN@valixen-cache.upstash.io:6379"
REDIS_KEY_PREFIX="valixen:prod:cache:"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SESSION MANAGEMENT (Auth.js / NextAuth v5)
# ------------------------------------------------------------------------------
# Generate cryptographically strong random secret with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_MIN_32_CHARACTERS_CRYPTOGRAPHIC_SECRET"
NEXTAUTH_URL="https://valixen.com"

# Production Cookie Domain (e.g., .valixen.com for subdomains, or leave empty)
COOKIE_DOMAIN=""

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH 2.0 CREDENTIALS (Google Cloud Console)
# ------------------------------------------------------------------------------
# Authorized Javascript Origins: https://valixen.com
# Authorized Redirect URIs: https://valixen.com/api/auth/callback/google
AUTH_GOOGLE_ID="CHANGE_ME_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="CHANGE_ME_GOOGLE_CLIENT_SECRET"

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED BRUTE FORCE & RATE LIMITING RULES
# ------------------------------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Session Lifetimes
SESSION_REMEMBER_DAYS=30
SESSION_TRANSIENT_HOURS=24

# ------------------------------------------------------------------------------
# 7. AI FINANCIAL ASSISTANT (Google Gemini API)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="CHANGE_ME_GEMINI_API_KEY"
AI_ASSISTANT_MODEL="gemini-1.5-flash"
AI_RATE_LIMIT_PER_MINUTE=25

# ------------------------------------------------------------------------------
# 8. ENCRYPTED COLD BACKUP ARCHIVE ENVELOPE (AES-256-GCM + HMAC-SHA256)
# ------------------------------------------------------------------------------
# 32-byte hexadecimal master key (64 hex characters): openssl rand -hex 32
BACKUP_ENCRYPTION_KEY="CHANGE_ME_HEX_64_CHARS_BACKUP_MASTER_KEY"
# HMAC secret for signature integrity verification
BACKUP_HMAC_SECRET="CHANGE_ME_HMAC_SECRET_FOR_BACKUP_VERIFICATION"

# ------------------------------------------------------------------------------
# 9. CORS & NETWORK ACCESS RESTRICTIONS
# ------------------------------------------------------------------------------
# Comma-separated list of whitelisted external domains
CORS_ALLOWED_ORIGINS="https://valixen.com,https://terminal.valixen.com,https://api.valixen.com"

# ------------------------------------------------------------------------------
# 10. ERROR MONITORING & TELEMETRY (Sentry / Datadog / OpenTelemetry)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
LOG_LEVEL="info"

# ------------------------------------------------------------------------------
# 11. CLOUDFLARE EDGE PROTECTION & WAF (Optional Edge Integration)
# ------------------------------------------------------------------------------
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_TOKEN=""
