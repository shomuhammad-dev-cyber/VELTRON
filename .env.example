# ==============================================================================
# VELTRON BESPOKE ROYAL LUXURY FINANCIAL ECOSYSTEM
# Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for development or configure in Vercel / Supabase Dashboard.
# STRICT SECURITY WARNING: NEVER COMMIT ACTUAL PRODUCTION SECRETS TO GIT REPOSITORIES.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION HOSTING & CANONICAL DOMAIN
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_URL="https://veltron.vercel.app"
NEXT_PUBLIC_APP_NAME="VELTRON"

# ------------------------------------------------------------------------------
# 2. SUPABASE MANAGED POSTGRESQL DATABASE & POOLER (Prisma Accelerate / Supavisor)
# ------------------------------------------------------------------------------
# Transaction pooler URL (Port 6543, pgbouncer=true for production Next.js queries)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL for schema migrations & DDL (Port 5432, bypasses transaction pooler)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 3. SUPABASE CLIENT CREDENTIALS (Authentication, Realtime, Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.CHANGE_ME_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.CHANGE_ME_SERVICE_ROLE_KEY"

# ------------------------------------------------------------------------------
# 4. OFFICIAL TELEGRAM BOT & MINI APP (TMA) INTEGRATION
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="CHANGE_ME_TELEGRAM_BOT_TOKEN"
TELEGRAM_BOT_USERNAME="VeltronAI_Bot"
TELEGRAM_ADMIN_CHAT_ID="CHANGE_ME_ADMIN_CHAT_ID"
TELEGRAM_WEBHOOK_SECRET="veltron_production_webhook_secret_key"

# ------------------------------------------------------------------------------
# 5. HIGH-SPEED DISTRIBUTED CACHE & RATE LIMITING (Redis / Upstash)
# ------------------------------------------------------------------------------
REDIS_URL="rediss://default:CHANGE_ME_REDIS_TOKEN@veltron-cache.upstash.io:6379"
REDIS_KEY_PREFIX="veltron:prod:cache:"

# ------------------------------------------------------------------------------
# 6. AUTHENTICATION & SESSION MANAGEMENT (Auth.js / NextAuth v5)
# ------------------------------------------------------------------------------
AUTH_SECRET="CHANGE_ME_MIN_32_CHARACTERS_CRYPTOGRAPHIC_SECRET"
NEXTAUTH_URL="https://veltron.vercel.app"
COOKIE_DOMAIN=""

# ------------------------------------------------------------------------------
# 7. GOOGLE OAUTH 2.0 CREDENTIALS (Google Cloud Console)
# ------------------------------------------------------------------------------
AUTH_GOOGLE_ID="CHANGE_ME_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="CHANGE_ME_GOOGLE_CLIENT_SECRET"

# ------------------------------------------------------------------------------
# 8. DISTRIBUTED BRUTE FORCE & RATE LIMITING RULES
# ------------------------------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
SESSION_REMEMBER_DAYS=30
SESSION_TRANSIENT_HOURS=24

# ------------------------------------------------------------------------------
# 9. AI FINANCIAL ASSISTANT (Google Gemini API)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="CHANGE_ME_GEMINI_API_KEY"
AI_ASSISTANT_MODEL="gemini-1.5-flash"
AI_RATE_LIMIT_PER_MINUTE=25

# ------------------------------------------------------------------------------
# 10. ENCRYPTED COLD BACKUP ARCHIVE ENVELOPE (AES-256-GCM + HMAC-SHA256)
# ------------------------------------------------------------------------------
BACKUP_ENCRYPTION_KEY="CHANGE_ME_HEX_64_CHARS_BACKUP_MASTER_KEY"
BACKUP_HMAC_SECRET="CHANGE_ME_HMAC_SECRET_FOR_BACKUP_VERIFICATION"

# ------------------------------------------------------------------------------
# 11. CORS & SECURITY
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS="https://veltron.vercel.app,http://localhost:3000"
LOG_LEVEL="info"
